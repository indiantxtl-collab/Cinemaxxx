# Copy to .env.local (Next.js) and fill in values from YOUR new deployment.
# This file intentionally contains no working credentials or database address.
# On Vercel: Project -> Settings -> Environment Variables. Redeploy after changes.

# Required: the NEW cinemaxxx Neon project's copied connection string.
# Prefer Neon's pooled connection string for the deployed app. Keep SSL enabled.
# DATABASE_URL is the canonical name; do not point it at the original CINEMAX DB.
DATABASE_URL=
# Supported fallbacks if DATABASE_URL is absent (first present wins):
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Required for admin authentication. Missing/short values fail closed (HTTP 503).
# Generate JWT_SECRET locally with: openssl rand -base64 48
# It must contain at least 32 characters and be different from the original app.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required for production canonical URLs/sharing and the Android build.
# Use this fork's actual HTTPS origin, without a path. No upstream domain default.
NEXT_PUBLIC_SITE_URL=
# Android build.sh reads this separately (export the same origin before building):
# CINEMAXXX_SITE_URL=

# Optional, server-only torrent gateway. Disabled unless explicitly enabled.
TORRENT_STREAMING_ENABLED=false
TORRENT_GATEWAY_URL=
TORRENT_GATEWAY_TOKEN=
# Optional playback tuning; leave private-host access disabled in production.
# CINEMAX_PLAYBACK_ALLOW_PRIVATE_HOSTS=false
# CINEMAX_PLAYBACK_DEADLINE_MS=

# Release Android signing: supply your own private keystore, alias and passwords.
# See android/README.md; never commit production keys or passwords.
# CINEMAXXX_KEYSTORE=
# CINEMAXXX_KEY_ALIAS=
# CINEMAXXX_STORE_PASS=
# CINEMAXXX_KEY_PASS=

# Test/CLI-only names (set in the process environment, not public browser config):
# BASE_URL=http://localhost:3000
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# PLAYWRIGHT_CHROMIUM_ARGS=
# PLAYBACK_FIXTURE_BASE=
# FIXTURE_ROOT=
# PORT=
